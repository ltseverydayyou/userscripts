// ==UserScript==
// @name         work.ink Ultimate Bypass + Overlay Cleaner (v1.8)
// @namespace    https://www.openbash.com/
// @version      1.8
// @description  Hide/remove only the VPN/Proxy/AdBlocker & “Access Options” pricing modals, keep all other overlays working, and track “Accept” clicks.
// @match        *://*.work.ink/*
// @grant        none
// @run-at       document-start
// ==/UserScript==

(function() {
  'use strict';

  // ────────────────────────────────────────────────────────────────────────────────
  // PART 0: Inject CSS for our hide-class & ensure the body never stays locked out
  // ────────────────────────────────────────────────────────────────────────────────
  const css = `
    .__vpnAdBypass { display: none !important; }
    body {
      overflow: auto !important;
      pointer-events: auto !important;
      filter: none !important;
      opacity: 1 !important;
      visibility: visible !important;
    }
  `;
  const styleTag = document.createElement('style');
  styleTag.textContent = css;
  document.head.appendChild(styleTag);


  // ────────────────────────────────────────────────────────────────────────────────
  // PART 1: Decide if a wrapper should be bypassed
  // (Matches both the old .modalwrapper *and* the new .main-modal)
  // ────────────────────────────────────────────────────────────────────────────────
  function shouldBypass(wrapper) {
    // look for any header text in .title, h1 or h2
    const header = wrapper.querySelector('.title, h1, h2');
    if (!header) return false;
    const txt = header.textContent.trim();
    return (
      /VPN Was Detected|Proxy Was Detected|AdBlocker/i.test(txt) ||
      /Access Options/i.test(txt)
    );
  }


  // ────────────────────────────────────────────────────────────────────────────────
  // PART 2: Hide & remove any matching overlays
  // ────────────────────────────────────────────────────────────────────────────────
  function purgeOverlays() {
    document.querySelectorAll('.modalwrapper, .main-modal').forEach(w => {
      if (shouldBypass(w)) {
        w.classList.add('__vpnAdBypass');  // instant CSS hide
        w.remove();                        // then remove from DOM
      }
    });
  }


  // ────────────────────────────────────────────────────────────────────────────────
  // PART 3: Other cleanup (safe-browsing, cookie banners, body style)
  // ────────────────────────────────────────────────────────────────────────────────
  function removeSafeBrowsing() {
    document.querySelectorAll('h1').forEach(h1 => {
      if (h1.textContent.includes('Google Safe Browsing')) {
        const m = h1.closest('div.fixed.top-16.left-0.right-0.bottom-0');
        if (m) m.remove();
      }
    });
  }

  function removeCookieBanner() {
    const b = document.getElementById('qc-cmp2-container');
    if (b) b.remove();
  }

  function restoreBody() {
    Object.assign(document.body.style, {
      overflow:      'auto',
      pointerEvents: 'auto',
      filter:        'none',
      opacity:       '1',
      visibility:    'visible'
    });
    document.body.removeAttribute('inert');
  }


  // ────────────────────────────────────────────────────────────────────────────────
  // PART 4: Offer-tracking & “Go To Destination” unlock (unchanged)
  // ────────────────────────────────────────────────────────────────────────────────
  const REQUIRED_OFFERS = 2;
  let completedOffers = 0;

  function updateSubtitle() {
    const sub = document.querySelector('.subtitle');
    if (!sub) return;
    const rem = Math.max(REQUIRED_OFFERS - completedOffers, 0);
    sub.textContent =
      `Complete ${rem} more offer${rem!==1?'s':''} to continue (${completedOffers} of ${REQUIRED_OFFERS} done)`;
  }

  function enableDestination() {
    const btn = document.getElementById('access-offers');
    if (!btn) return;
    btn.disabled = false;
    btn.removeAttribute('disabled');
    btn.style.pointerEvents = 'auto';
    btn.style.opacity       = '1';
  }

  function handleAcceptClick(ev) {
    const btn = ev.currentTarget;
    if (btn.dataset.accepted) return;
    btn.dataset.accepted = 'true';
    completedOffers++;
    updateSubtitle();
    if (completedOffers >= REQUIRED_OFFERS) {
      enableDestination();
    }
  }

  function initOfferTracking() {
    document.querySelectorAll('.interestedBtn').forEach(btn=>{
      btn.addEventListener('click', handleAcceptClick);
    });
    if (completedOffers >= REQUIRED_OFFERS) {
      enableDestination();
    }
  }


  // ────────────────────────────────────────────────────────────────────────────────
  // PART 5: Combined cleanup & init, run early & often
  // ────────────────────────────────────────────────────────────────────────────────
  function cleanupAll() {
    purgeOverlays();
    removeSafeBrowsing();
    removeCookieBanner();
    restoreBody();
    enableDestination();
  }

  function onReady() {
    cleanupAll();
    initOfferTracking();
  }

  // run on key events & poll in case of late injections
  window.addEventListener('DOMContentLoaded', onReady);
  window.addEventListener('load',            onReady);
  setInterval(onReady, 500);

  // MutationObserver to catch dynamically-injected modals
  new MutationObserver(onReady)
    .observe(document.documentElement, {
      childList: true,
      subtree:   true
    });

})();
